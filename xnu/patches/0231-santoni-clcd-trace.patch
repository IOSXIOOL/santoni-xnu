 void
 AppleCLCD::blitPanel()
 {
+	static uint32_t sBlitLog;
+	static uint32_t sPinId;
+	static uint32_t sWant;
+	static uint32_t sStretch;
+	static uint32_t sCrop;
+	static int sWantRead;
 	if (fBpp != 3 || fPanelVA == 0 || fPixels == 0) {
 		return;
 	}
+	{
+		uint32_t bestnz = 0, bestid = 0;
+		if ((sPinId == 0) || ((sBlitLog % 15) == 0)) {
+			for (uint32_t id = 1; id < 64; id++) {
+				SweetSurface *t = sweet_surface_copy(id);
+				if (t == NULL) continue;
+				if (t->bytesPerElement == 4 && t->width >= fWidth && t->height >= fHeight) {
+					const uint32_t *q = (const uint32_t *)t->kernelAddress();
+					uint32_t total = t->width * t->height, step = total / 1024, nz = 0;
+					if (step == 0) step = 1;
+					for (uint32_t i = 0; i < total; i += step) {
+						if (q[i] & 0x00ffffffu) nz++;
+					}
+					IOLog("SWEET SURF PROBE: id=%u %ux%u nz=%u first=0x%08x\n",
+					    id, t->width, t->height, nz, q[0]);
+					if (nz > 8 && nz >= bestnz) {
+						bestnz = nz;
+						bestid = id;
+					}
+				}
+				OSSafeReleaseNULL(t);
+			}
+		}
+		if (bestid == 0) {
+			bestid = sPinId;
+		}
+		SweetSurface *best = bestid ? sweet_surface_copy(bestid) : NULL;
+		uint32_t live = 0;
+		if (best != NULL && best->bytesPerElement == 4 && best->width >= fWidth) {
+			const uint32_t *qc = (const uint32_t *)best->kernelAddress();
+			uint32_t totalc = best->width * best->height, stepc = totalc / 256;
+			if (qc != NULL) {
+				if (stepc == 0) stepc = 1;
+				for (uint32_t i2 = 0; i2 < totalc; i2 += stepc) {
+					if (qc[i2] & 0x00ffffffu) live++;
+				}
+			}
+		}
+		if (best != NULL && live == 0) {
+			sPinId = 0;
+			OSSafeReleaseNULL(best);
+		}
+		if (best != NULL && best->bytesPerElement == 4 && best->width >= fWidth) {
+			const uint32_t *src = (const uint32_t *)best->kernelAddress();
+			uint32_t sw = best->width, sh = best->height;
+			uint32_t sstride = best->bytesPerRow / 4;
+			if (sCrop) {
+				for (uint32_t cy = 0; cy < fHeight; cy++) {
+					const uint32_t *crow = src + (uint64_t)cy * sstride;
+					uint8_t *cout = (uint8_t *)(fPanelVA + (uint64_t)cy * fPanelStride);
+					for (uint32_t cx = 0; cx < fWidth; cx++) {
+						uint32_t cp2 = crow[cx];
+						cout[0] = (uint8_t)cp2;
+						cout[1] = (uint8_t)(cp2 >> 8);
+						cout[2] = (uint8_t)(cp2 >> 16);
+						cout += 3;
+					}
+				}
+				__asm__ volatile("dsb sy" ::: "memory");
+				if (sPinId != bestid) {
+					sPinId = bestid;
+					IOLog("SWEET FB: PIN surf=%u crop nz=%u blit=%u\n",
+					    bestid, bestnz, (unsigned)sBlitLog);
+				}
+				OSSafeReleaseNULL(best);
+				sBlitLog++;
+				return;
+			}
+			uint32_t fit = (uint32_t)(((uint64_t)sw * fHeight) / sh);
+			uint32_t scaled_h, ypad, yoff, xoff, sxstep, y, x;
+			if (!sWantRead) {
+				sWantRead = 1;
+				PE_parse_boot_argn("sweetfit", &sWant, sizeof(sWant));
+				PE_parse_boot_argn("sweetstretch", &sStretch, sizeof(sStretch));
+				PE_parse_boot_argn("sweetcrop", &sCrop, sizeof(sCrop));
+			}
+			if (sWant > 0 && sWant <= fWidth) fit = sWant;
+			if (fit == 0 || fit > fWidth) fit = fWidth;
+			scaled_h = (uint32_t)(((uint64_t)sh * fit) / sw);
+			if (sStretch) {
+				fit = fWidth;
+				scaled_h = fHeight;
+			}
+			ypad = scaled_h < fHeight ? (fHeight - scaled_h) / 2 : 0;
+			yoff = scaled_h > fHeight ? (scaled_h - fHeight) / 2 : 0;
+			xoff = (fWidth - fit) / 2;
+			sxstep = (uint32_t)(((uint64_t)sw << 16) / fit);
+			for (y = 0; y < fHeight; y++) {
+				uint8_t *out = (uint8_t *)(fPanelVA + (uint64_t)y * fPanelStride);
+				uint32_t sx = 0;
+				if (y < ypad || y >= ypad + scaled_h) {
+					for (x = 0; x < fWidth; x++) {
+						out[0] = 0;
+						out[1] = 0;
+						out[2] = 0;
+						out += 3;
+					}
+					continue;
+				}
+				{
+					uint32_t sy = (uint32_t)(((uint64_t)(y - ypad + yoff) * sh) / scaled_h);
+					const uint32_t *row = src + (uint64_t)sy * sstride;
+					for (x = 0; x < xoff; x++) {
+						out[0] = 0;
+						out[1] = 0;
+						out[2] = 0;
+						out += 3;
+					}
+					for (x = 0; x < fit; x++) {
+						uint32_t p = row[sx >> 16];
+						sx += sxstep;
+						out[0] = (uint8_t)p;
+						out[1] = (uint8_t)(p >> 8);
+						out[2] = (uint8_t)(p >> 16);
+						out += 3;
+					}
+					for (x = xoff + fit; x < fWidth; x++) {
+						out[0] = 0;
+						out[1] = 0;
+						out[2] = 0;
+						out += 3;
+					}
+				}
+			}
+			__asm__ volatile("dsb sy" ::: "memory");
+			if (sPinId != bestid) {
+				sPinId = bestid;
+				IOLog("SWEET FB: PIN surf=%u nz=%u fit=%u h=%u ypad=%u blit=%u\n",
+				    bestid, bestnz, fit, scaled_h, ypad, (unsigned)sBlitLog);
+			}
+			OSSafeReleaseNULL(best);
+			sBlitLog++;
+			return;
+		}
+		OSSafeReleaseNULL(best);
+	}
+	if ((sBlitLog < 3) || ((sBlitLog % 120) == 0)) {
+		const uint32_t *probe = (const uint32_t *)fPixels;
+		uint32_t pixels = fWidth * fHeight, step = pixels / 2048, nz = 0, i;
+		if (step == 0) step = 1;
+		for (i = 0; i < pixels; i += step) {
+			if (probe[i] & 0x00ffffffu) nz++;
+		}
+		IOLog("SWEET FB: blit #%u %ux%u stride %u->%u va=0x%llx\n", (unsigned)sBlitLog,
+		    (unsigned)fWidth, (unsigned)fHeight, (unsigned)fRowBytes, (unsigned)fPanelStride,
+		    (unsigned long long)fPanelVA);
+		IOLog("SWEET FB: PIXELS #%u first=0x%08x nz=%u/%u\n", (unsigned)sBlitLog,
+		    probe[0], (unsigned)nz, (unsigned)(pixels / step));
+	}
+	sBlitLog++;
 	sweet_bgra_to_bgr24(fPanelVA, fPanelStride, (const uint8_t *)fPixels,
 	    fRowBytes, fWidth, fHeight);
 	/* Write-combining memory: complete the stores before the panel fetches. */
